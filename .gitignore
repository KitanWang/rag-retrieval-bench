# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# 数据与产物（体积大 / 可重建，不入库）
data/raw/
data/processed/
data/milvus/
# artifacts 只保留「报告直接引用的小体积证据」，大体积明细（含每条查询的排序结果）不入库。
# 取舍标准：读报告的人能否仅凭入库文件核对到每个数字。
artifacts/*
!artifacts/RESULTS.md          # 报告快照（由 ragbench report 生成）
!artifacts/backend_bench.json  # 向量后端基准（约 1 KB）
!artifacts/fusion_tuning.json  # 融合策略扫描（约 3 KB）
outputs/
*.db
*.sqlite*

# 日志与临时
*.log
.DS_Store
